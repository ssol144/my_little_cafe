# MY LITTLE CAFE - environment variables
# Copy to .env (never commit .env). Vite only exposes variables prefixed with VITE_.

# Shown in the settings screen (build label).
VITE_APP_VERSION=0.1.0

# Enables the in-game debug hooks (window.__game) without ?debug=1. Keep false in production.
VITE_ENABLE_DEBUG=false

# Reserved for the future cloud-save backend. Leave empty: the game uses local saves when unset.
VITE_CLOUD_SAVE_URL=
