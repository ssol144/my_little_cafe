# MY LITTLE CAFE - environment variables
# Copy to .env (never commit .env). Vite only exposes variables prefixed with VITE_.

# Shown in the settings screen (build label).
VITE_APP_VERSION=0.1.0

# Enables the in-game debug hooks (window.__game) without ?debug=1. Keep false in production.
VITE_ENABLE_DEBUG=false

# ---- Firebase (Google login + cloud save) ----
# Firebase console > Project settings > General > Your apps > Web app > SDK config.
# These are public client identifiers (they ship inside the app); data is protected by firestore.rules.
# Leave them empty to build without any account features (the game then uses local saves only).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# true = use the local Firebase emulators (tests / development only)
VITE_FIREBASE_EMULATOR=false
