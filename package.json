{
  "name": "my-little-cafe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node scripts/e2e.mjs",
    "cap:sync": "npm run build && npx cap sync android",
    "android:apk": "npm run cap:sync && cd android && ./gradlew assembleDebug",
    "test:systems": "node scripts/e2e-systems.mjs",
    "android:assets": "node scripts/gen-android-assets.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@fontsource/jua": "^5.3.0",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@types/three": "^0.187.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "engines": {
    "node": ">=20"
  }
}
