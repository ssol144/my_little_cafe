rules_version = '2';

// MY LITTLE CAFE: each signed-in player can only read/write their own save document.
service cloud.firestore {
  match /databases/{database}/documents {
    match /saves/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }
      function validSave() {
        let d = request.resource.data;
        return d.keys().hasOnly(['data', 'clientUpdatedAt', 'device', 'version', 'summary', 'updatedAt'])
          && d.keys().hasAll(['data', 'clientUpdatedAt', 'device', 'version', 'summary'])
          && d.data is string && d.data.size() < 900000
          && d.clientUpdatedAt is number
          && d.device is string && d.device.size() < 64
          && d.version is int
          && d.summary is map;
      }
      allow read, delete: if isOwner();
      allow create, update: if isOwner() && validSave();
    }
    // everything else is closed
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
